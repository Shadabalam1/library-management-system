PORT=4000
NODE_ENV=production
FRONTEND_URL=https://your-client.example.com
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/lms
SMTP_HOST=smtp.gmail.com
SMTP_SERVICE=gmail
SMTP_PORT=465
SMTP_MAIL=your-email@example.com
SMTP_PASSWORD=your-app-password
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE=3d
COOKIE_EXPIRE=3
COOKIE_SAME_SITE=None
# Set only when the client and API share a parent domain.
COOKIE_DOMAIN=
CLOUDINARY_CLIENT_NAME=your-cloudinary-cloud
CLOUDINARY_CLIENT_API=your-cloudinary-api-key
CLOUDINARY_CLIENT_SECRET=your-cloudinary-api-secret